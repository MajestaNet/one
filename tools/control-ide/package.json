{
  "name": "@one/control-ide",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Majesta One Control IDE — client-only Electron shell for customer repo + Deploy APIs (ADR-012)",
  "main": "dist-electron/main.js",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build && tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "lint": "eslint .",
    "audit:high": "node ./scripts/npm-audit-high.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "postinstall": "node ./node_modules/electron/install.js",
    "smoke:electron": "node scripts/electron-security-smoke.mjs",
    "electron:dev": "vite build && tsc -p tsconfig.node.json && electron .",
    "dist": "npm run build && electron-builder --config electron-builder.yml",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "dist:linux": "npm run build && electron-builder --linux --config electron-builder.yml",
    "assert-artifacts": "bash ../../scripts/assert-ide-artifacts.sh"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.17",
    "@base-ui/react": "^1.7.0",
    "@dagrejs/dagre": "^1.1.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.5.8",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@xyflow/react": "^12.11.2",
    "electron-updater": "^6.6.2",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/dagre": "^0.7.52",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "4.1.4",
    "minimatch": "10.2.5"
  }
}
