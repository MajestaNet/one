# Local `make api` / `make worker` loop (copy to gitignored `.env`).
# Two-install SI lab: deploy/docker-compose.multi-env.yml or
# docs/customer-rollout-test-run.md native fallback — do not reuse these
# JWT / claim values across sibling installs.

APP_ENV=development
DATABASE_URL=postgres://one:one@localhost:5432/one
PORT=8080
HOST=0.0.0.0
API_KEYS=dev-admin-key+admin,dev-agent-key:client
AUTH_JWT_SIGNING_KEY=dev-one-jwt-hmac-secret-change-me
INSTALL_CLAIM_TOKEN=local-dev-claim-token-change-me
PLATFORM_PUBLIC_URL=http://localhost:8080
AUTO_SEED=1
SEED_CONTROL_IDE=1
FEATURE_FLAGS=agents
CUSTOMER_ID=local-customer
INSTALL_ID=local
INSTALL_ROLE=dev
PRODUCT_VERSION=0.1.0
API_REVISION_CURRENT=1
API_REVISION_MIN=1
IDENTITY_SYNC=off

# Guest automations + Deploy --suite (native go run). Product images set this
# to /usr/local/bin/deno. Suites run in the API process; async automations run
# in the worker — export DENO_PATH (or put Deno 2.9.3 on PATH) in both shells.
# DENO_PATH=/usr/local/bin/deno
